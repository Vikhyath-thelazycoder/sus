{
  "name": "sustainiq",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr-assets.mjs && vite",
    "build": "node scripts/copy-ocr-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "CLOUDFLARE_ENV=production npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate:local": "wrangler d1 migrations apply sustainiq-db-dev --local -c wrangler.toml",
    "cf-typegen": "wrangler types -c wrangler.toml",
    "db:migrate:dev": "wrangler d1 migrations apply sustainiq-db-dev --remote -c wrangler.toml",
    "db:migrate:prod": "wrangler d1 migrations apply sustainiq-db --remote -c wrangler.toml --env production",
    "verify": "npm test && npm run typecheck && npm run lint && npm run build",
    "ingest": "tsx scripts/ingest.ts",
    "start:render": "tsx src/server/node.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@hono/node-server": "^2.1.6",
    "@tesseract.js-data/eng": "^1.0.0",
    "hono": "^4.13.16",
    "openai": "^7.51.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22"
  }
}
